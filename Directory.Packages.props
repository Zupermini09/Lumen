<Project>
  <!-- All package versions are pinned here (central package management). Ask before adding new packages. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <LibVlcSharpVersion>3.10.2</LibVlcSharpVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Playback -->
    <PackageVersion Include="LibVLCSharp" Version="$(LibVlcSharpVersion)" />
    <PackageVersion Include="LibVLCSharp.Avalonia" Version="$(LibVlcSharpVersion)" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageVersion Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />

    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
