<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:views="using:Lumen.UI.Views"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Lumen.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="HorizontalPanel">
      <StackPanel Orientation="Horizontal" Spacing="16" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="Card" DataType="vm:MediaCardViewModel">
      <views:MediaCard />
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller">
    <StackPanel Margin="24" Spacing="12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
          <ui:SymbolIcon Symbol="Refresh" />
        </Button>
        <StackPanel>
          <TextBlock Text="Home" Classes="title" />
          <TextBlock Text="{Binding Greeting}" Classes="secondary" />
        </StackPanel>
      </DockPanel>

      <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" IsVisible="{Binding IsLoading}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

      <!-- My media, Continue watching, Next up, then Latest in each library; rows without cards are hidden. -->
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:HomeRow">
            <StackPanel Spacing="8" Margin="0,0,0,12" IsVisible="{Binding HasCards}">
              <TextBlock Text="{Binding Title}" Classes="section" />
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Cards}" ItemsPanel="{StaticResource HorizontalPanel}"
                              ItemTemplate="{StaticResource Card}" />
              </ScrollViewer>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
