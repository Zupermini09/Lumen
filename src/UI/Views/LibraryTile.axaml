<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:imaging="using:Lumen.UI.Imaging"
             x:Class="Lumen.UI.Views.LibraryTile"
             x:DataType="vm:MediaCardViewModel">
  <!-- A library on Home: the server's artwork, sharp and as it is (it usually carries the library's name already), with the
       name as a caption below like the other cards. Only a library without artwork gets a small label in the tile. -->
  <Button Classes="card" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
          Width="{Binding Width}" HorizontalContentAlignment="Stretch" Click="OnClick" ToolTip.Tip="{Binding Title}">
    <StackPanel Spacing="3">
      <Border Classes="poster" Height="{Binding ImageHeight}" Margin="0,0,0,5">
        <Panel>
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="10"
                     VerticalAlignment="Center" HorizontalAlignment="Center" Classes="tertiary" FontSize="13" />
          <Image Stretch="UniformToFill" Height="{Binding ImageHeight}" imaging:RemoteImage.Uri="{Binding ImageUri}" />
          <Border Classes="hoverShade" />
        </Panel>
      </Border>
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" />
    </StackPanel>
  </Button>
</UserControl>
