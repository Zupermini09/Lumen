<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:views="using:Lumen.UI.Views"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Lumen.UI.Views.ItemsView"
             x:DataType="vm:ItemsViewModel">
  <DockPanel Margin="24,24,8,0">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,16,12">
      <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
        <ui:SymbolIcon Symbol="Refresh" />
      </Button>
      <StackPanel>
        <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Summary}" Classes="secondary" />
      </StackPanel>
    </DockPanel>

    <!-- Sort and filter (libraries and collections only). -->
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="12" LineSpacing="8" Margin="0,0,16,12" IsVisible="{Binding HasOptions}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Sort by" VerticalAlignment="Center" Classes="secondary" />
        <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" MinWidth="170">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:SortChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Command="{Binding ToggleDirectionCommand}" ToolTip.Tip="Change the order">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="↑" IsVisible="{Binding !IsDescending}" />
            <TextBlock Text="↓" IsVisible="{Binding IsDescending}" />
            <TextBlock Text="{Binding DirectionLabel}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Show" VerticalAlignment="Center" Classes="secondary" />
        <ComboBox ItemsSource="{Binding PlayedChoices}" SelectedItem="{Binding SelectedPlayed}" MinWidth="120">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:PlayedChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ToggleButton IsChecked="{Binding FavoritesOnly}" ToolTip.Tip="Only favourites">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:SymbolIcon Symbol="Favorite" />
            <TextBlock Text="Favourites" />
          </StackPanel>
        </ToggleButton>
        <DropDownButton Content="{Binding GenreLabel}" IsVisible="{Binding HasGenres}">
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <ScrollViewer MaxHeight="360" x:DataType="vm:ItemsViewModel">
                <ItemsControl ItemsSource="{Binding Genres}" MinWidth="200">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GenreChoice">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasFilters}" />
      </StackPanel>
    </WrapPanel>

    <Panel>
      <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" IsVisible="{Binding ShowSpinner}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
      <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Margin="0,0,16,0" IsVisible="{Binding ShowProgressBar}" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
      <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Classes="secondary" />

      <!-- Virtualized: only the rows on screen (plus a small buffer) are created, so large libraries stay light. -->
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CardRow"><views:CardRowView /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
