<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:Lumen.UI.Views"
             x:Class="Lumen.UI.Views.TransportBar"
             x:DataType="vm:TransportViewModel">
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding PositionText}" VerticalAlignment="Center" MinWidth="56" />
      <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" Margin="8,0" />
      <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
    </Grid>
    <DockPanel>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding SkipLabel}" IsVisible="{Binding HasSkip}" Classes="accent" Click="OnSkipClick"
                ToolTip.Tip="Skip (S)" />
        <Button Content="−15" ToolTip.Tip="Back 15 seconds (Left)" MinWidth="44" Click="OnBackClick" />
        <Button Command="{Binding TogglePauseCommand}" ToolTip.Tip="Play / pause (Space)" Width="44">
          <ui:SymbolIcon Symbol="{Binding IsPlaying, Converter={x:Static views:TransportBar.PlayPauseSymbol}}" />
        </Button>
        <Button Content="+15" ToolTip.Tip="Forward 15 seconds (Right)" MinWidth="44" Click="OnForwardClick" />
        <Button Command="{Binding StopCommand}" ToolTip.Tip="Stop" Width="44">
          <ui:SymbolIcon Symbol="Stop" />
        </Button>
        <TextBlock Text="{Binding State}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
        <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Chapters" ToolTip.Tip="Chapters" Click="OnChaptersClick" />
        <Button Content="Audio" ToolTip.Tip="Audio track" Click="OnAudioClick" />
        <Button Content="Subtitles" ToolTip.Tip="Subtitles (G / H: delay)" Click="OnSubtitlesClick" />
        <Button Content="{Binding SpeedText}" ToolTip.Tip="Playback speed ([ / ])" MinWidth="52" Click="OnSpeedClick" />
        <ToggleButton IsChecked="{Binding IsMuted}" ToolTip.Tip="Mute (M)" Width="44">
          <ui:SymbolIcon Symbol="Mute" />
        </ToggleButton>
        <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="140" VerticalAlignment="Center" />
        <Button ToolTip.Tip="Full screen (F)" Width="44" Click="OnFullScreenClick">
          <ui:SymbolIcon Symbol="FullScreenMaximize" />
        </Button>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</UserControl>
