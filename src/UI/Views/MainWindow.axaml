<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:Lumen.UI.ViewModels"
        xmlns:views="using:Lumen.UI.Views"
        x:Class="Lumen.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://Lumen.UI/Assets/lumen.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:LoadingViewModel">
      <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
    </DataTemplate>
    <DataTemplate DataType="vm:ConnectViewModel"><views:ConnectView /></DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:SearchViewModel"><views:SearchView /></DataTemplate>
    <DataTemplate DataType="vm:FavoritesViewModel"><views:FavoritesView /></DataTemplate>
    <DataTemplate DataType="vm:ItemsViewModel"><views:ItemsView /></DataTemplate>
    <DataTemplate DataType="vm:ItemDetailsViewModel"><views:ItemDetailsView /></DataTemplate>
    <DataTemplate DataType="vm:SeriesDetailsViewModel"><views:SeriesDetailsView /></DataTemplate>
    <DataTemplate DataType="vm:PlayerViewModel"><views:PlayerView /></DataTemplate>
    <DataTemplate DataType="vm:PlaybackTestViewModel"><views:PlaybackTestView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel"><views:AboutView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <!-- Solid window background; with an OS backdrop (Mica / blur) it turns mostly transparent, see MainWindow.axaml.cs. -->
    <Style Selector="Panel#Root">
      <Setter Property="Background" Value="{DynamicResource LumenBackgroundBrush}" />
    </Style>
    <Style Selector="Window.backdrop Panel#Root">
      <Setter Property="Background" Value="{DynamicResource LumenBackdropBrush}" />
    </Style>
    <Style Selector="Window.backdrop">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Panel x:Name="Root">
    <!-- Grain over the window background; sits under all content. -->
    <Border Background="{DynamicResource LumenNoiseBrush}" IsHitTestVisible="False" />

  <DockPanel>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="14,5"
            BorderBrush="{DynamicResource LumenHairlineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" Classes="caption" />
        <TextBlock Text="{Binding Version, StringFormat='Lumen {0}'}" Classes="caption" />
        <TextBlock Text="{Binding SignedInAs}" Classes="caption" Margin="16,0,0,0" />
      </DockPanel>
    </Border>

    <!-- Title area: back button above the icon column, then the logo. -->
    <Border x:Name="TopBar" DockPanel.Dock="Top" Height="44"
            BorderBrush="{DynamicResource LumenHairlineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BackButton" Classes="subtle" Width="40" Height="32" Margin="4,0,4,0" Padding="0"
                IsEnabled="{Binding CanGoBack}" Click="OnBackClick" ToolTip.Tip="Back (Alt+Left)">
          <ui:SymbolIcon Symbol="Back" FontSize="16" />
        </Button>
        <Path Data="{StaticResource LumenWordmarkGeometry}" Fill="{DynamicResource LumenLogoBrush}" Stretch="Uniform"
              Height="18" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <ui:NavigationView x:Name="Navigation"
                       PaneDisplayMode="LeftCompact"
                       IsSettingsVisible="True"
                       IsBackButtonVisible="False"
                       OpenPaneLength="220"
                       Content="{Binding CurrentPage}">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Home" Tag="Home">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Home" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Search" Tag="Search" ToolTip.Tip="Search (Ctrl+F)">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Find" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Favourites" Tag="Favorites">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Favorite" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Play a file" Tag="PlayFile">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Play" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="About" Tag="About">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Help" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Sign out" Tag="SignOut">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Contact" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </DockPanel>
  </Panel>
</Window>
