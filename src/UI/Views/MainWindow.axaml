<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:Lumen.UI.ViewModels"
        xmlns:views="using:Lumen.UI.Views"
        x:Class="Lumen.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://Lumen.UI/Assets/lumen.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:LoadingViewModel">
      <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
    </DataTemplate>
    <DataTemplate DataType="vm:ConnectViewModel"><views:ConnectView /></DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:ItemsViewModel"><views:ItemsView /></DataTemplate>
    <DataTemplate DataType="vm:PlayerViewModel"><views:PlayerView /></DataTemplate>
    <DataTemplate DataType="vm:PlaybackTestViewModel"><views:PlaybackTestView /></DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel"><views:AboutView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="12,4"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" FontSize="12" Opacity="0.7" />
        <TextBlock Text="{Binding Version, StringFormat='Lumen {0}'}" FontSize="12" Opacity="0.7" />
        <TextBlock Text="{Binding SignedInAs}" FontSize="12" Opacity="0.7" Margin="16,0,0,0" />
      </DockPanel>
    </Border>

    <ui:NavigationView x:Name="Navigation"
                       PaneDisplayMode="LeftCompact"
                       IsSettingsVisible="False"
                       IsBackButtonVisible="True"
                       IsBackEnabled="{Binding CanGoBack}"
                       OpenPaneLength="220"
                       Content="{Binding CurrentPage}">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Home" Tag="Home">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Home" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Play a file" Tag="PlayFile">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Play" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="About" Tag="About">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Help" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Sign out" Tag="SignOut">
          <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="Contact" /></ui:NavigationViewItem.IconSource>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </DockPanel>
</Window>
