<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:imaging="using:Lumen.UI.Imaging"
             x:Class="Lumen.UI.Views.CastRow"
             x:DataType="vm:DetailsViewModelBase">
  <StackPanel Spacing="8" IsVisible="{Binding HasCast}">
    <TextBlock Text="Cast" Classes="section" />
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
      <ItemsControl ItemsSource="{Binding Cast}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:PersonCardViewModel">
            <StackPanel Width="112" Spacing="4" ToolTip.Tip="{Binding Name}">
              <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True"
                      Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                <Panel>
                  <TextBlock Text="{Binding Initials}" FontSize="26" Classes="tertiary"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Stretch="UniformToFill" Height="96" imaging:RemoteImage.Uri="{Binding ImageUri}" />
                </Panel>
              </Border>
              <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Role}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Classes="secondary" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
