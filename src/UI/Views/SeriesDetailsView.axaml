<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:views="using:Lumen.UI.Views"
             xmlns:imaging="using:Lumen.UI.Imaging"
             xmlns:core="using:Lumen.Core.Jellyfin"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Lumen.UI.Views.SeriesDetailsView"
             x:DataType="vm:SeriesDetailsViewModel">
  <ScrollViewer>
    <Panel>
      <views:DetailsBackdrop />

      <StackPanel Margin="32,24,32,32" Spacing="24">
        <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" IsVisible="{Binding IsLoading}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32">
          <Border Width="{Binding PosterWidth}" Height="{Binding PosterHeight}" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top"
                  Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Panel>
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Classes="tertiary" />
              <Image Stretch="UniformToFill" Height="{Binding PosterHeight}" imaging:RemoteImage.Uri="{Binding PosterUri}" />
            </Panel>
          </Border>

          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Tagline}" FontStyle="Italic" Classes="secondary" TextWrapping="Wrap"
                       IsVisible="{Binding Tagline, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="{Binding MetaLine}" VerticalAlignment="Center" />
              <Border BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                      IsVisible="{Binding OfficialRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding OfficialRating}" FontSize="12" />
              </Border>
              <TextBlock Text="{Binding CommunityRating}" VerticalAlignment="Center"
                         IsVisible="{Binding CommunityRating, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <TextBlock Text="{Binding Genres}" Classes="secondary" TextWrapping="Wrap"
                       IsVisible="{Binding Genres, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,8,0,4">
              <Button Classes="accent" Command="{Binding PlayCommand}" IsVisible="{Binding HasPlayTarget}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ui:SymbolIcon Symbol="Play" />
                  <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ToggleWatchedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ui:SymbolIcon Symbol="Accept" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsVisible="{Binding IsPlayed}" />
                  <ui:SymbolIcon Symbol="Accept" IsVisible="{Binding !IsPlayed}" />
                  <TextBlock Text="{Binding WatchedLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ToggleFavoriteCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="★" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsVisible="{Binding IsFavorite}" />
                  <TextBlock Text="☆" FontSize="16" VerticalAlignment="Center" IsVisible="{Binding !IsFavorite}" />
                  <TextBlock Text="{Binding FavoriteLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="{Binding ActionError}" IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

            <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" LineHeight="22"
                       IsVisible="{Binding Overview, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
          <TextBlock Text="Seasons" Classes="section" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,8">
            <ListBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="core:MediaItem">
                  <TextBlock Text="{Binding Name}" Margin="4,2" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" IsVisible="{Binding IsLoadingEpisodes}" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding EpisodesError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding EpisodesError}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <Button Content="Retry" Command="{Binding RetryEpisodesCommand}" />
          </StackPanel>
          <TextBlock Text="No episodes in this season." Classes="secondary" IsVisible="{Binding HasNoEpisodes}" />

          <!-- A season holds at most a few dozen episodes, so a plain list is fine; the thumbnails load as rows are created. -->
          <ItemsControl ItemsSource="{Binding Episodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:EpisodeRowViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                  <Button Padding="8" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                      <Border Width="176" Height="99" CornerRadius="6" ClipToBounds="True"
                              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                        <Panel>
                          <Image Stretch="UniformToFill" Height="99" imaging:RemoteImage.Uri="{Binding ImageUri}" />
                          <Border IsVisible="{Binding IsPlayed}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                  Background="{DynamicResource LumenSuccessBrush}" CornerRadius="10" Width="20" Height="20">
                            <TextBlock Text="✓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LumenOnSuccessBrush}" />
                          </Border>
                          <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding Progress}" Maximum="1" VerticalAlignment="Bottom"
                                       MinHeight="4" Height="4" Margin="0" CornerRadius="0" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Runtime}" FontSize="12" Classes="secondary"
                                   IsVisible="{Binding Runtime, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   FontSize="13" Classes="secondary"
                                   IsVisible="{Binding Overview, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Command="{Binding PlayCommand}" VerticalAlignment="Center" ToolTip.Tip="Play">
                    <ui:SymbolIcon Symbol="Play" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <views:CastRow />
      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
