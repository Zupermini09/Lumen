<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Lumen.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="Theme" Value="{StaticResource SubtitleTextBlockStyle}" />
      <Setter Property="Margin" Value="0,16,0,2" />
    </Style>
    <Style Selector="ComboBox.value">
      <Setter Property="MinWidth" Value="230" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="32,24,32,32" Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Theme="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="Changes are saved and applied straight away. Playback settings take effect with the next video you play."
                 Opacity="0.7" TextWrapping="Wrap" />

      <TextBlock Classes="section" Text="Playback" />

      <ui:SettingsExpander Header="Skip intro, recap, credits..."
                           Description="What to do when playback reaches a segment marked by the server (needs a segment provider such as the Intro Skipper plugin).">
        <ui:SettingsExpander.Items>
          <ItemsControl ItemsSource="{Binding SegmentRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:SegmentRow">
                <ui:SettingsExpanderItem Content="{Binding Name}">
                  <ui:SettingsExpanderItem.Footer>
                    <ComboBox Classes="value" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                  </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:SettingsExpander.Items>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Play the next episode automatically"
                           Description="When an episode ends, start the next one after a short countdown.">
        <ui:SettingsExpander.Footer>
          <ToggleSwitch IsChecked="{Binding AutoPlayNextEpisode}" OnContent="On" OffContent="Off" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>
      <ui:SettingsExpander Header="Countdown" Description="How long the next-episode countdown runs."
                           IsEnabled="{Binding AutoPlayNextEpisode}">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding CountdownChoices}" SelectedItem="{Binding Countdown}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Skip back" Description="Used by the back button and the Left arrow key.">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding SkipBackChoices}" SelectedItem="{Binding SkipBack}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>
      <ui:SettingsExpander Header="Skip forward" Description="Used by the forward button and the Right arrow key.">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding SkipForwardChoices}" SelectedItem="{Binding SkipForward}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <TextBlock Classes="section" Text="Audio and subtitles" />

      <ui:SettingsExpander Header="Preferred audio language"
                           Description="Start with an audio track in this language when the video has one. Otherwise the server's choice is used.">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding AudioLanguageChoices}" SelectedItem="{Binding AudioLanguage}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>
      <ui:SettingsExpander Header="Subtitle mode" Description="When subtitles are turned on by themselves.">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding SubtitleModeChoices}" SelectedItem="{Binding SelectedSubtitleMode}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>
      <ui:SettingsExpander Header="Preferred subtitle language"
                           Description="Used by the modes that pick a subtitle track. Not used with the server default or when subtitles are off."
                           IsEnabled="{Binding UsesSubtitleLanguage}">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding SubtitleLanguageChoices}" SelectedItem="{Binding SubtitleLanguage}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <TextBlock Classes="section" Text="Video" />

      <ui:SettingsExpander Header="Hardware decoding"
                           Description="Let the graphics card decode video where the system supports it. Turn off if video shows glitches or playback fails.">
        <ui:SettingsExpander.Footer>
          <ToggleSwitch IsChecked="{Binding HardwareDecoding}" OnContent="On" OffContent="Off" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Streaming quality"
                           Description="The most video data the server sends. Original plays the file as it is (direct play); lower qualities are converted by the server, which also happens when a file cannot be played directly. Can also be changed while playing.">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding StreamingQualityChoices}" SelectedItem="{Binding StreamingQuality}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <TextBlock Classes="section" Text="Interface" />

      <ui:SettingsExpander Header="Theme" Description="Light or dark colours.">
        <ui:SettingsExpander.Footer>
          <ComboBox Classes="value" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
