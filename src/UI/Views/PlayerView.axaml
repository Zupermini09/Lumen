<views:VideoPage xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:Lumen.UI.ViewModels"
                 xmlns:views="using:Lumen.UI.Views"
                 x:Class="Lumen.UI.Views.PlayerView"
                 x:DataType="vm:PlayerViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <DockPanel x:Name="Header" Grid.Row="0" Margin="16,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border IsVisible="{Binding IsCountingDown}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="4" Padding="10,4">
          <TextBlock Text="{Binding CountdownText}" Foreground="{DynamicResource LumenOnAccentBrush}" VerticalAlignment="Center" />
        </Border>
        <Button Content="Cancel" IsVisible="{Binding IsCountingDown}" Click="OnCancelNextClick" />
        <Button IsVisible="{Binding HasNextEpisode}" Click="OnNextEpisodeClick" Classes="accent"
                ToolTip.Tip="{Binding NextEpisodeLabel}">
          <TextBlock Text="{Binding NextEpisodeLabel, StringFormat='Next: {0}'}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
        </Button>
        <Button x:Name="StartOverButton" Content="Start over" IsVisible="{Binding IsResuming}" Click="OnStartOverClick" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding ItemTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ItemSubtitle}" Classes="secondary" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding ItemSubtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="Black">
      <ContentControl x:Name="Host" />
    </Border>

    <views:TransportBar x:Name="Controls" Grid.Row="2" Margin="16,12" />
  </Grid>
</views:VideoPage>
