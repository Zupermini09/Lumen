<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:jf="using:Lumen.Core.Jellyfin"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Lumen.UI.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
  <Panel>
    <Border Background="{DynamicResource LumenGlowBrush}" IsHitTestVisible="False" />
    <ScrollViewer>
      <ContentControl Classes="glass strong" Padding="36,32" Margin="24" Width="460" MaxWidth="460"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="8">
          <Image Source="avares://Lumen.UI/Assets/lumen-256.png" Width="72" Height="72" HorizontalAlignment="Center" />
          <TextBlock Text="Connect to your server" Classes="title" FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0" />
          <TextBlock Text="Lumen is a desktop client for Jellyfin" Classes="caption" HorizontalAlignment="Center" />

          <TextBlock Text="Server address" Classes="caption" Margin="2,22,0,0" />
          <TextBox x:Name="AddressBox" Text="{Binding Address}" Watermark="e.g. 192.168.1.10:8096 or https://jellyfin.example.com">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Text="http and https both work. Without http(s)://, Lumen tries https first, then http on port 8096."
                     TextWrapping="Wrap" Classes="caption tertiary" Margin="2,0,0,0" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
            <Button Content="Connect" Classes="accent" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="16,10" />
            <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Width="24" Height="24" IsVisible="{Binding IsBusy}" />
          </Grid>

          <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" Foreground="{DynamicResource LumenErrorBrush}" />

          <StackPanel Spacing="8" IsVisible="{Binding HasRecentServers}" Margin="0,18,0,0">
            <TextBlock Text="Recent servers" Classes="caption" Margin="2,0,0,0" />
            <ItemsControl ItemsSource="{Binding RecentServers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="jf:SavedServer">
                  <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="14,9"
                          Command="{Binding $parent[UserControl].((vm:ConnectViewModel)DataContext).ConnectRecentCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource LumenTextBrush}" />
                      <TextBlock Text="{Binding Address}" Classes="caption" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button Content="Play a local file instead" Classes="link" Command="{Binding PlayLocalFileCommand}"
                  HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
      </ContentControl>
    </ScrollViewer>
  </Panel>
</UserControl>
