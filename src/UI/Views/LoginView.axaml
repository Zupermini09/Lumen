<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:imaging="using:Lumen.UI.Imaging"
             x:Class="Lumen.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="14" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="{Binding ServerName, StringFormat='Sign in to {0}'}" Theme="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{Binding ServerDescription}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Users the server shows on its login screen -->
      <ItemsControl ItemsSource="{Binding Users}" IsVisible="{Binding HasUsers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:UserCardViewModel">
            <Button Margin="0,0,12,12" Padding="8" Background="Transparent" BorderThickness="0" Width="96"
                    Command="{Binding $parent[UserControl].((vm:LoginViewModel)DataContext).SelectUserCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                  <Panel>
                    <TextBlock Text="{Binding Initial}" FontSize="26" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Width="64" Height="64" Stretch="UniformToFill" imaging:RemoteImage.Uri="{Binding ImageUri}" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="User name" />
      <TextBox x:Name="UserBox" Text="{Binding UserName}" />
      <TextBlock Text="Password" />
      <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" RevealPassword="False">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Sign in" Classes="accent" Command="{Binding SignInCommand}" MinWidth="120" />
        <Button Content="Use Quick Connect" Command="{Binding StartQuickConnectCommand}"
                IsVisible="{Binding IsQuickConnectAvailable}" />
        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" IsVisible="{Binding IsBusy}" />
      </StackPanel>

      <Border IsVisible="{Binding IsQuickConnectActive}" Padding="16" CornerRadius="8"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="Quick Connect code" FontWeight="SemiBold" />
          <SelectableTextBlock Text="{Binding QuickConnectCode}" FontSize="36" FontFamily="Consolas,Menlo,monospace"
                               LetterSpacing="6" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="On a device where you are already signed in, open Settings → Quick Connect and enter this code. Lumen signs in automatically once you approve it." />
          <Button Content="Cancel" Command="{Binding CancelQuickConnectCommand}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

      <Button Content="Use a different server" Command="{Binding ChangeServerCommand}"
              Background="Transparent" BorderThickness="0" Padding="0" Opacity="0.7" Margin="0,8,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
