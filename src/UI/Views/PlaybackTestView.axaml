<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:Lumen.UI.Views"
             x:Class="Lumen.UI.Views.PlaybackTestView"
             x:DataType="vm:PlaybackTestViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <!-- Source -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0" Text="{Binding Source}"
               Watermark="Local file path or stream URL (http, https, rtsp...)" />
      <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick" />
      <Button Grid.Column="2" Content="Play" Margin="8,0,0,0" Classes="accent"
              Command="{Binding PlayCommand}" />
    </Grid>

    <!-- Video -->
    <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
      <ContentControl x:Name="VideoHost" />
    </Border>

    <!-- Transport -->
    <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding PositionText}" VerticalAlignment="Center" MinWidth="56" />
        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}"
                Value="{Binding PositionSeconds}" Margin="8,0" />
        <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" MinWidth="56"
                   TextAlignment="Right" />
      </Grid>
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding TogglePauseCommand}" ToolTip.Tip="Play / pause" Width="44">
            <ui:SymbolIcon Symbol="{Binding IsPlaying, Converter={x:Static views:PlaybackTestView.PlayPauseSymbol}}" />
          </Button>
          <Button Command="{Binding StopCommand}" ToolTip.Tip="Stop" Width="44">
            <ui:SymbolIcon Symbol="Stop" />
          </Button>
          <TextBlock Text="{Binding State}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
          <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center" Margin="8,0,0,0"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <ToggleButton IsChecked="{Binding IsMuted}" ToolTip.Tip="Mute" Width="44">
            <ui:SymbolIcon Symbol="Mute" />
          </ToggleButton>
          <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="140" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Engine}" VerticalAlignment="Center" Opacity="0.5" FontSize="12" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Grid>
</UserControl>
