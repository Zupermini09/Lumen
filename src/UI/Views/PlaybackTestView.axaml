<views:VideoPage xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:Lumen.UI.ViewModels"
                 xmlns:views="using:Lumen.UI.Views"
                 x:Class="Lumen.UI.Views.PlaybackTestView"
                 x:DataType="vm:PlaybackTestViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0" Text="{Binding Source}"
               Watermark="Local file path or stream URL (http, https, rtsp...)">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding PlayCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick" />
      <Button Grid.Column="2" Content="Play" Margin="8,0,0,0" Classes="accent" Command="{Binding PlayCommand}" />
    </Grid>

    <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
      <ContentControl x:Name="Host" />
    </Border>

    <views:TransportBar Grid.Row="2" Margin="0,12,0,0" />
  </Grid>
</views:VideoPage>
