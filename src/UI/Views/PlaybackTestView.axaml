<views:VideoPage xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:Lumen.UI.ViewModels"
                 xmlns:views="using:Lumen.UI.Views"
                 x:Class="Lumen.UI.Views.PlaybackTestView"
                 x:DataType="vm:PlaybackTestViewModel">
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid x:Name="SourceBar" Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0" Text="{Binding Source}"
               Watermark="Local file path or stream URL (http, https, rtsp...)">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding PlayCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Browse…" Classes="quiet" Margin="8,0,0,0" Click="OnBrowseClick" />
      <Button Grid.Column="2" Content="Play" Margin="8,0,0,0" Classes="accent" Command="{Binding PlayCommand}" />
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource LumenVideoBrush}" CornerRadius="{DynamicResource LumenRadiusSmall}" ClipToBounds="True">
      <ContentControl x:Name="Host" />
    </Border>

    <ContentControl x:Name="Controls" Grid.Row="2" Classes="glass bar" Margin="0,12,0,0">
      <views:TransportBar />
    </ContentControl>
  </Grid>
</views:VideoPage>
